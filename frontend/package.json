{
  "name": "inventario-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Inventario frontend — React 19 + Tailwind v4 + shadcn/ui.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json,md}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "codegen": "node scripts/codegen.mjs",
    "codegen:check": "node scripts/codegen.mjs --check",
    "i18n:extract": "i18next-parser",
    "i18n:check": "node scripts/i18n-check.mjs",
    "size": "size-limit",
    "size:why": "size-limit --why",
    "lhci": "lhci autorun",
    "clean": "rm -rf dist node_modules/.tmp"
  },
  "dependencies": {
    "@hookform/resolvers": "7.0.9",
    "@tanstack/react-query": "5.108.4",
    "@zxcvbn-ts/core": "4.3.0",
    "@zxcvbn-ts/language-common": "4.2.0",
    "@zxcvbn-ts/language-en": "4.1.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "i18next": "27.2.9",
    "i18next-browser-languagedetector": "8.3.1",
    "i18next-resources-to-backend": "1.3.0",
    "lucide-react": "1.78.0",
    "pdfjs-dist": "6.5.438",
    "qrcode.react": "4.2.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.92.0",
    "react-i18next": "18.0.3",
    "react-router-dom": "7.18.6",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.1",
    "tw-animate-css": "1.4.0",
    "vaul": "1.1.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@lhci/cli": "0.16.1",
    "@size-limit/file": "14.3.0",
    "@tailwindcss/vite": "4.3.5",
    "@tanstack/react-query-devtools": "5.108.4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/jest-axe": "3.5.9",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.1",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.8",
    "globals": "17.14.0",
    "i18next-cli": "1.94.1",
    "jest-axe": "11.0.0",
    "jsdom": "31.0.1",
    "msw": "3.0.7",
    "openapi-typescript": "7.13.0",
    "prettier": "3.10.1",
    "size-limit": "14.3.0",
    "swagger2openapi": "7.0.8",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "overridesComment": "nanoid is pinned to a patched 3.x for postcss, which asks for ^3.3.16 and would otherwise resolve below the GHSA fix line. tmp and uuid are the same kind of transitive-advisory pin.",
  "overrides": {
    "tmp": "0.2.7",
    "uuid": "14.0.3",
    "nanoid": "3.3.20",
    "lighthouse": "13.6.0"
  },
  "engines": {
    "node": "26.13.1"
  }
}
