<!doctype html>
<html lang="en">
<body>
<p>Hi {{.Name}},</p>
<p>Here is what happened in your Inventario groups between
{{.DigestWeekStart}} and {{.DigestWeekEnd}}.</p>
{{- range .DigestGroups}}
<p><strong>{{.GroupName}}</strong></p>
<ul>
{{- if .ItemsAdded}}
<li>Items added: {{.ItemsAdded}}</li>
{{- end}}
{{- if .ItemsChanged}}
<li>Items changed: {{.ItemsChanged}}</li>
{{- end}}
{{- if .FilesAdded}}
<li>Files attached: {{.FilesAdded}}</li>
{{- end}}
</ul>
{{- end}}
{{- if .DigestUpcoming}}
<p><strong>Coming up</strong></p>
<ul>
{{- range .DigestUpcoming}}
<li>
{{- if eq .Kind "warranty"}}Warranty expires {{.Date}}:{{else}}Maintenance due {{.Date}}:{{end}}
{{- if .URL}} <a href="{{.URL}}">{{.Name}}</a>{{else}} {{.Name}}{{end}}
({{.GroupName}})</li>
{{- end}}
</ul>
{{- end}}
{{- if .DigestURL}}
<p>Open Inventario: <a href="{{.DigestURL}}">{{.DigestURL}}</a></p>
{{- end}}
{{- if .DigestSettingsURL}}
<p>To stop receiving this, turn off the weekly digest in your notification
settings: <a href="{{.DigestSettingsURL}}">{{.DigestSettingsURL}}</a></p>
{{- end}}
</body>
</html>
